# spotify now-playing widget
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# admin content editor. generate both with: npm run admin:password
# ADMIN_SECRET signs the session cookie, 32+ chars.
ADMIN_SECRET=
# scrypt hash of the admin password. the password itself is never stored.
ADMIN_PASSWORD_HASH=

# vercel blob store holding the published content. added automatically by
# `vercel env pull` once the store is linked to the project.
BLOB_READ_WRITE_TOKEN=
